# Inference service (defaults shown; paths are discovered automatically in a checkout)
CIFR_CATALOG_PATH=./data/generated/expanded/catalog.jsonl
CIFR_VISUAL_INDEX_DIR=./data/generated/expanded/siglip
CIFR_LOCAL_FEATURE_INDEX=./data/generated/expanded/local_features.npz
CIFR_IMAGES_DIR=./data/generated/expanded/images
CIFR_OCR_MODEL_DIR=./services/inference/data/ocr
CIFR_FUSION_PATH=./services/inference/data/fusion.json
CIFR_FOUND_PROBABILITY=0.80
CIFR_MAX_UPLOAD_BYTES=15728640

# Web client (baked into the web build)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
SITE_ORIGIN=http://localhost:3000
